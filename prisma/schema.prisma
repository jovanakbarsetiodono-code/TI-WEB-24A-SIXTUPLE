generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model tb_ticket {
  id     Int    @id @default(autoincrement())
  nama   String
  harga  Int
}

model tb_pemesanan {
  id                Int    @id @default(autoincrement())
  nama_pemesan      String
  no_hp             String
  jenis_tiket       String
  jumlah_tiket      Int
  tanggal_kunjungan String
  total_harga       Int
}